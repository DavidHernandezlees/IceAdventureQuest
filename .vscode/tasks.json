{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Install Android SDK tools (Windows)",
      "type": "process",
      "command": "cmd.exe",
      "args": [
        "/d",
        "/c",
        "setup-android.cmd"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Run Ice Adventure Quest on Android (Windows)",
      "type": "process",
      "command": "cmd.exe",
      "args": [
        "/d",
        "/c",
        "run-android.cmd"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
